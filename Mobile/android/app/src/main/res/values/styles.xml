<resources>

    <!-- Main app theme — transparent status bar so RN gradient headers extend behind it -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>

    <!--
        Splash theme: shown by Android OS instantly while the JS bundle loads.
        Uses the layer-list drawable (gradient + centered icon + app name).
        MainActivity switches away from this to AppTheme in onCreate()
        so the transition is seamless.
    -->
    <style name="SplashTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowFullscreen">false</item>
    </style>

</resources>
