
## .gitignore

```gitignore
# Backend
backend/target/
backend/.idea/
backend/*.iml
backend/.settings/
backend/.classpath
backend/.project
backend/.sts4-cache/

# Frontend
frontend/node_modules/
frontend/build/
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
frontend/coverage/
frontend/.cache/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker
*.pid
*.seed
*.pid.lock

# Environment files
.env
.env.local
.env.*.local

# Test coverage
coverage/

# Build outputs
dist/
out/
